# Tech4Food Smart Fridge — Backend Environment Configuration Example
# Copy this file to .env and configure local values

# Application Settings
ENVIRONMENT=development
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8001

# CORS Configuration (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Database & Repository Configuration
# SQLite is the default local persistent repository.
# Set USE_IN_MEMORY_REPO=true to use the temporary in-memory store for isolated tests.
# Set SUPABASE_URL and SUPABASE_KEY when Supabase PostgreSQL integration is active.
USE_IN_MEMORY_REPO=false
SQLITE_DB_PATH=backend/data/foodguard.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_CHECK_INTERVAL_SECONDS=900
ESP32_WEBHOOK_SECRET=
